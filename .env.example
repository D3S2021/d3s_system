# ============================================================
# Variables de entorno requeridas para Sistema D3S
# Copiá este archivo como .env y completá los valores reales.
# NUNCA commiteés el .env con valores reales.
# ============================================================

# --- Django (OBLIGATORIO) ---
# Generá una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-segura

# --- Modo debug (en producción debe ser 0) ---
DEBUG=1

# --- Hosts permitidos (separados por coma) ---
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CSRF trusted origins (para Render u otro hosting) ---
# Ejemplo: https://mi-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Base de datos (dejar vacío usa SQLite en desarrollo) ---
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- Logging ---
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# --- WhatsApp Cloud API (opcional) ---
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_TEST_TO=+549XXXXXXXXXX
